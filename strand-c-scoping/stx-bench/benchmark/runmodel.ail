module benchmark/runmodel

-- Full-corpus runner for ONE model (the tier-descent unit — a driver loops it
-- per panel model, one `ailang run --ai <id>` each, aggregating stdout). Reads
-- the runnable items from items.jsonl, solves each via the --ai-bound model, and
-- emits one results.jsonl line per item to stdout.
--
-- PER-MODEL BUDGET is enforced NATIVELY by AILANG (the run's budget flag, set per
-- model by the driver). This runner just reacts to AIError.BudgetExhausted: it
-- stops cleanly, keeping the partial results already emitted. No token counting
-- here — that's AILANG's job.
--
-- Needs items.jsonl to carry a `question_text` field (Stage A / problem-text
-- slicing). Until then, questions are empty — use --ai-stub to validate loading.
--
--   TRIAL_MODEL=<stamp> ailang run --ai <id> <budget-flag> --caps IO,FS,AI,Env \
--     --entry main benchmark/runmodel.ail
--
-- Deterministic grading only (FACIT parse -> grader); parse-fail -> "ambiguous".
-- The LLM judge layer-2 (needs raw_key) is a follow-up.

import benchmark/keyparse (Numeric, Symbolic, NeedsReview, extractFacit)
import benchmark/grader (Expected, gradeNumeric, verdictLabel)
import benchmark/solver (systemPrompt, userMessage)
import std/ai (Message, StepResult, AIError, step)
import std/fs (readFile)
import std/env (getEnvOr)
import std/json (decode, getString, getBool, getNumber, getArray, getObject, asString, Json)
import std/option (Option, Some, None, getOrElse)
import std/result (Result, Ok, Err)
import std/string (trim, split, length as strLen)
import std/list (map, filter)

type Item = {
  item_id: string, set: string, subq: string, topics: [string],
  question: string, expected: Expected
}

-- ---- load runnable items (with question_text) ------------------------------

pure func parseTopics(arr: [Json]) -> [string] =
  filter(\s. strLen(s) > 0, map(\j. getOrElse(asString(j), ""), arr))

pure func rowToItem(j: Json) -> Option[Item] =
  if getOrElse(getBool(j, "runnable"), false) then
    match getObject(j, "expected") {
      Some(exp) =>
        Some({
          item_id: getOrElse(getString(j, "item_id"), "?"),
          set: getOrElse(getString(j, "set"), ""),
          subq: getOrElse(getString(j, "subq"), ""),
          topics: parseTopics(getOrElse(getArray(j, "topics"), [])),
          question: getOrElse(getString(j, "question_text"), ""),
          expected: {
            value: getOrElse(getNumber(exp, "value"), 0.0),
            unit: getOrElse(getString(exp, "unit"), ""),
            tolerance_rel: getOrElse(getNumber(exp, "tolerance_rel"), 0.05)
          }
        }),
      None => None
    }
  else None

pure func collectItems(lines: [string]) -> [Item] =
  match lines {
    [] => [],
    l :: rest =>
      if trim(l) == "" then collectItems(rest)
      else
        match decode(l) {
          Ok(j)  => match rowToItem(j) { Some(it) => it :: collectItems(rest), None => collectItems(rest) },
          Err(_) => collectItems(rest)
        }
  }

func loadItems(path: string) -> [Item] ! {FS} {
  let raw = readFile(path);
  collectItems(split(raw, "\n"))
}

-- ---- solve + emit ----------------------------------------------------------

func solve(q: string) -> Result[StepResult, AIError] ! {AI} {
  let msgs = [
    { role: "system", content: systemPrompt(), tool_calls: [], tool_call_id: "" },
    { role: "user",   content: userMessage(q), tool_calls: [], tool_call_id: "" }
  ];
  step("", msgs, [])
}

pure func quoteJoin(xs: [string]) -> string =
  match xs {
    [] => "",
    x :: rest => match rest { [] => "\"${x}\"", _ => "\"${x}\",${quoteJoin(rest)}" }
  }

pure func line(it: Item, model: string, verdict: string, inTok: int, outTok: int) -> string =
  "{\"item_id\":\"${it.item_id}\",\"set\":\"${it.set}\",\"subq\":\"${it.subq}\",\"topics\":[${quoteJoin(it.topics)}],\"model\":\"${model}\",\"verdict\":\"${verdict}\",\"in_tokens\":${show(inTok)},\"out_tokens\":${show(outTok)}}"

-- Loop over items. AILANG enforces the per-model budget; on BudgetExhausted we
-- stop cleanly (partial results already on stdout). Other transient errors emit
-- an "error" line and continue to the next item.
func run(model: string, items: [Item]) -> () ! {AI, IO} {
  match items {
    [] => (),
    it :: rest =>
      match solve(it.question) {
        Ok(r) => {
          let verdict =
            match extractFacit(r.message.content) {
              Numeric(v, u)  => verdictLabel(gradeNumeric(it.expected, v, u)),
              Symbolic       => "ambiguous",
              NeedsReview(_) => "ambiguous"
            };
          println(line(it, model, verdict, r.input_tokens, r.output_tokens));
          run(model, rest)
        },
        Err(e) => {
          println(line(it, model, "error", 0, 0));
          if e.code == "BudgetExhausted" then () else run(model, rest)
        }
      }
  }
}

export func main() -> () ! {AI, IO, FS, Env} {
  run(getEnvOr("TRIAL_MODEL", "unknown"), loadItems("runs/stage0/items.jsonl"))
}
