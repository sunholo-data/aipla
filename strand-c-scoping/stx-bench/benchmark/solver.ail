module benchmark/solver

-- Solver + judge prompts for the STX Fysik-A benchmark. Pure (no AI effect
-- here — the harness shell in stage1.ail does the calling). Solver prompt is
-- Danish (the student role); the judge prompt is English with Danish quotes
-- inline, per the kickoff.

-- System prompt: the student role + the answer-format contract. The contract
-- (final line `FACIT: <value> <unit>`) is what the deterministic grader keys on.
export pure func systemPrompt() -> string =
  "Du er en dygtig gymnasieelev til skriftlig eksamen i Fysik A (stx). Løs delspørgsmålet med korrekt fysik. Vis metoden: opskriv og isolér formlen før du indsætter tal, og før enheder med i beregningen. Du må bruge standardværdier fra Databogen. Brug ikke værktøjer eller internet. Afslut ALTID med en linje for sig selv på formen:\nFACIT: <værdi> <enhed>\nmed passende antal betydende cifre (typisk 2). Skriv kun ét facit."

-- The user message is the (cleaned) subquestion text plus a final reinforcement
-- of the answer-format contract. Models weight the last message heavily, and the
-- smoke test showed the system-prompt instruction alone was not reliably followed
-- (the model wrote the result in prose instead of a FACIT line).
export pure func userMessage(questionText: string) -> string =
  "${questionText}\n\nAfslut dit svar med præcis denne linje og intet efter den:\nFACIT: <værdi> <enhed>"

-- JSON schema (as a string) for the LLM judge's structured verdict. Used with
-- std/ai.callJsonResult so the provider enforces the shape.
export pure func judgeSchema() -> string =
  "{\"type\":\"object\",\"properties\":{\"verdict\":{\"type\":\"string\",\"enum\":[\"correct\",\"incorrect\",\"ambiguous\"]},\"reason\":{\"type\":\"string\"}},\"required\":[\"verdict\",\"reason\"]}"

-- Judge input: only invoked when deterministic parsing fails or the item is
-- non-numeric. Judges the final RESULT against the official key; method
-- differences are fine, unit errors are wrong.
export pure func judgeInput(modelAnswer: string, rawKey: string) -> string =
  "You are grading a Danish stx Fysik A exam answer against the official key. Judge only the final result, not the method: different correct methods are fine, but a wrong unit is wrong. Return JSON {verdict, reason}.\n\nMODEL ANSWER:\n${modelAnswer}\n\nOFFICIAL KEY:\n${rawKey}"
